<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dnote.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Dnote.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico">

        <Grid>
        <!-- Define columns: Left panel, Splitter, Right panel -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150" MaxWidth="500" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!-- Left Side Content -->
        <Border Grid.Column="0" 
                Background="#F5F5F5" 
                Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="Left Panel" 
                           FontSize="18" 
                           FontWeight="Bold" />
                <TextBlock Text="Place navigation, tree view, or sidebar content here." 
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Vertical GridSplitter -->
        <GridSplitter Grid.Column="1" 
                      Width="6" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Stretch" 
                      Background="#CCCCCC"
                      ShowsPreview="False" />

        <!-- Right Side Content -->
        <Border Grid.Column="2" 
                Background="#FFFFFF" 
                Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="Right Panel" 
                           FontSize="18" 
                           FontWeight="Bold" />
                <TextBlock Text="Main content view goes here." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
