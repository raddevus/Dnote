<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dnote.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Dnote.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico">

    <Grid>
        <!-- Define columns: Left panel, Splitter, Right panel -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150" MaxWidth="500" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!-- Left Side Content -->
        <Border Name="LeftBorder" Grid.Column="0" 
                Background="#F5F5F5" 
                Padding="16">
            <StackPanel Spacing="10">
                <CalendarDatePicker Name="entryDatePicker" 
                                    PlaceholderText="EntryDate" />
                <LayoutTransformControl>
                    <LayoutTransformControl.LayoutTransform>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                    </LayoutTransformControl.LayoutTransform>
                    <!-- The always-visible full calendar -->
                    <Calendar SelectedDate="{Binding CurrentDate}"
                              DisplayDate="{Binding CurrentDate}"
                              SelectedDatesChanged="Calendar_DisplayDateChanged" />
                </LayoutTransformControl>
                <TextBlock Text="Left Panel" 
                           FontSize="18" 
                           FontWeight="Bold" />
                <TextBlock Text="Place navigation, tree view, or sidebar content here." 
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Vertical GridSplitter -->
        <GridSplitter Grid.Column="1" 
                      Width="6" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Stretch" 
                      Background="#CCCCCC"
                      ShowsPreview="False" />

        <!-- Right Side Content -->
        <Border Name="RightBorder" Grid.Column="2" 
                Background="#FFFFFF" 
                Padding="16">
            <Grid RowDefinitions="Auto,*">
                
                <!-- Toolbar for adding tabs and actions -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                    <Button Content="+ New Tab" Command="{Binding AddTabCommand}" />
<Button x:Name="Save" Click="OnClickSave"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
     Save 
  </Button>
<Button x:Name="AddOne" Click="OnClick"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    Press Me!
  </Button>
                </StackPanel>
                <!-- Dynamic TabControl -->
                <TabControl x:Name="DocTabControl" Grid.Row="1" 
                            ItemsSource="{Binding Tabs}" 
                            SelectedItem="{Binding SelectedTab}">
                    
                    <!-- Tab Header Template -->
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="vm:DocumentTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                                <Button Content="✕" 
                                        Padding="2,0" 
                                        FontSize="10"
                                        Command="{Binding $parent[TabControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <!-- Tab Content Template -->
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="vm:DocumentTabViewModel">
                            <Grid RowDefinitions="*,Auto" Margin="0,10,0,0">
                                <RichTextEditor Grid.Row="0" Name="EditorX">
                                    <RichTextEditor.Document>
                                        <FlowDocument>
                                            <Paragraph>
                                                <RichRun Text="Welcome to " />
                                                <RichBold>
                                                    <RichRun Text="RichTextEditor" />
                                                </RichBold>
                                                <RichRun Text="!" />
                                            </Paragraph> 
                                        </FlowDocument>
                                    </RichTextEditor.Document>
                                </RichTextEditor>
                                
                                <StackPanel Grid.Row="1" Spacing="4" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding FileName, StringFormat='File: {0}'}" 
                                               FontSize="12" 
                                               Foreground="Gray" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
